AWS_ACCESS_KEY_ID="" # ローカル実行で必須
AWS_SECRET_ACCESS_KEY="" # ローカル実行で必須
AWS_REGION="ap-northeast-1"

# PostgreSQL接続文字列（ローカル開発用。本番は Secrets Manager から自動解決）
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myfriend"

# Bedrock モデルID
AGENT_MODEL_ID="global.anthropic.claude-haiku-4-5-20251001-v1:0"
EXTRACTION_MODEL_ID="global.anthropic.claude-haiku-4-5-20251001-v1:0"
CONSOLIDATION_MODEL_ID="global.anthropic.claude-haiku-4-5-20251001-v1:0"
EMBEDDING_MODEL_ID="amazon.titan-embed-text-v2:0"
RERANK_MODEL_ID="amazon.rerank-v1:0"
REFLECT_MODEL_ID="global.anthropic.claude-haiku-4-5-20251001-v1:0"

# Tavily API（Web検索）
TAVILY_API_KEY=""
