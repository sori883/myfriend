AWS_ACCESS_KEY_ID="" # ローカル実行で必須
AWS_SECRET_ACCESS_KEY="" # ローカル実行で必須

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myfriend"

# AWS (IAM role preferred; set only for local dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION="ap-northeast-1"

# Bedrock Model IDs (optional — all have hardcoded defaults)
CONSOLIDATION_MODEL_ID="anthropic.claude-3-haiku-20240307-v1:0"
REFLECT_MODEL_ID="anthropic.claude-3-haiku-20240307-v1:0"
EMBEDDING_MODEL_ID="amazon.titan-embed-text-v2:0"

# Batch settings
BATCH_MAX_BANKS=50
LAMBDA_SAFETY_TIMEOUT_SECONDS=780
